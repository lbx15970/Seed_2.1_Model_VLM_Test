# ===== 火山方舟凭证（region: cn-beijing）=====
# 请填入你自己的 API Key，不要提交到仓库
ARK_API_KEY=your_ark_api_key_here

# ===== 端点选择 =====
# ark（默认）    -> https://ark.cn-beijing.volces.com/api/v3   URL 视频 ≤50MB，本项目视频 43-45MB 够用
# mediakit（可选）-> https://amk-ark.cn-beijing.volces.com/api/v1  URL 视频 ≤5GB，仅超大视频才需要
ARK_ENDPOINT=ark

# 仅当 ARK_ENDPOINT=mediakit 时需要（用于视频拉取/预处理鉴权）
MEDIAKIT_API_KEY=

# 可选：直接覆盖 base_url（留空则由 ARK_ENDPOINT 推导）
ARK_BASE_URL=

# ===== 默认运行参数 =====
# DEFAULT_MODEL 可填别名（seed-2-1-turbo / seed-2-1-pro / seed-evolving）
# 实际运行时会映射到 config/cases.yaml 中配置的模型 Endpoint ID
DEFAULT_MODEL=seed-2-1-turbo
# 抽帧帧率：短剧建议 1.0~2.0，帧率越高时间戳越准但 token/耗时越高
DEFAULT_FPS=2.0
